# --- BDNS / SNPSAP ---
# API pública, no requiere key (verificado 2026-08-11). Se deja aquí por si
# cambia la política de acceso o se necesita un identificador de vpd propio.
BDNS_BASE_URL=https://www.infosubvenciones.es/bdnstrans/api
BDNS_VPD=GE

# --- Supabase (se rellena en F1/F4) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- LLM local (extracción de plazo, F2) ---
# Ollama corriendo en local (gratis) — ver docs/adr/0004-extraccion-gratis-regex-llm-local.md.
# Precalienta el modelo antes de un lote grande: extraction.llm_ollama.calentar_modelo().
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# --- LLM de pago (OPCIONAL, no usado por defecto) ---
# El pipeline es gratis por diseño (regex + Ollama resuelven el 91.3% del
# plazo, ver docs/f2-deadline-coverage.md). Deja esto vacío salvo que
# quieras comparar calidad/coste contra Claude para el resto.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MONTHLY_BUDGET_EUR=5
ANTHROPIC_API_KEY=

# --- Email (F4/F5) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# --- n8n (F3) ---
N8N_WEBHOOK_URL=
