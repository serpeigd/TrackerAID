# --- BDNS / SNPSAP ---
# API pública, no requiere key (verificado 2026-08-11). Se deja aquí por si
# cambia la política de acceso o se necesita un identificador de vpd propio.
BDNS_BASE_URL=https://www.infosubvenciones.es/bdnstrans/api
BDNS_VPD=GE

# --- Supabase (se rellena en F1/F4) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- LLM (extracción estructurada, F2) ---
# Presupuesto mensual duro en EUR para cortar llamadas si se dispara el coste.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MONTHLY_BUDGET_EUR=5
ANTHROPIC_API_KEY=

# --- Email (F4/F5) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# --- n8n (F3) ---
N8N_WEBHOOK_URL=
